      "parameters": {
        "jsCode": "// ===== CONFIG =====\nconst ACCOUNT_SID = 'AC0eed0a0301b825f8b65f07bc44522bac';\nconst AUTH_TOKEN = '4ba62cb7cc8cfd561eb27d0a7377dadc';\n\n// ===== ROW VALUES =====\nconst rawFrom = String($json.From || \"\");\nconst rawTo = String($json.To || \"\");\nconst STAGE = $json.Stage ?? \"0\";\nconst SHEET_NAME = $json.Sheet_Name ?? \"\";\nconst ORIGINAL_BODY = String($json.Message_Body || \"\");\nconst ORIGINAL_TIME = $json.Time_To_Sent || \"\";\nconst ROW_NUMBER = $json.row_number ?? \"\";\n\n// ===== FORMAT NUMBERS =====\nconst FROM_NUMBER = '+' + rawFrom.replace(/\\D/g, '');\nconst TO_NUMBER = '+' + rawTo.replace(/\\D/g, '');\n\n// ===== FOLLOW-UP MESSAGE =====\nconst MESSAGE_BODY = `Just checking back regarding the property. Let me know if selling is something you'd consider.`;\n\n// ===== NEW TIME =====\nconst TIME_TO_SENT = new Date().toISOString();\n\n// ===== TWILIO =====\nconst url = `https://api.twilio.com/2010-04-01/Accounts/${ACCOUNT_SID}/Messages.json`;\nconst authHeader = Buffer.from(`${ACCOUNT_SID}:${AUTH_TOKEN}`).toString('base64');\n\ntry {\n  const body =\n    `To=${encodeURIComponent(TO_NUMBER)}` +\n    `&From=${encodeURIComponent(FROM_NUMBER)}` +\n    `&Body=${encodeURIComponent(MESSAGE_BODY)}`;\n\n  const response = await this.helpers.httpRequest({\n    method: 'POST',\n    url,\n    headers: {\n      Authorization: `Basic ${authHeader}`,\n      'Content-Type': 'application/x-www-form-urlencoded',\n    },\n    body,\n  });\n\n  return [{\n    json: {\n      status: 'SENT',\n      sid: response.sid,\n      From: rawFrom,\n      To: rawTo,\n      Time_To_Sent: TIME_TO_SENT,\n      Message_Body: MESSAGE_BODY,\n      Old_Message_Body: ORIGINAL_BODY,\n      Old_Time_To_Sent: ORIGINAL_TIME,\n      Stage: \"1\",\n      Sheet_Name: SHEET_NAME,\n      row_number: ROW_NUMBER\n    }\n  }];\n\n} catch (err) {\n  return [{\n    json: {\n      status: 'FAILED',\n      error: err?.response?.body || err.message,\n      From: rawFrom,\n      To: rawTo,\n      Time_To_Sent: TIME_TO_SENT,\n      Message_Body: MESSAGE_BODY,\n      Old_Message_Body: ORIGINAL_BODY,\n      Old_Time_To_Sent: ORIGINAL_TIME,\n      Stage: STAGE,\n      Sheet_Name: SHEET_NAME,\n      row_number: ROW_NUMBER\n    }\n  }];\n}"
